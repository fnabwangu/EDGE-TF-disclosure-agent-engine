## Rebalance Schedule & Execution Governance (`config/rebalance_schedule.json`)

The `rebalance_schedule.json` file configures the portfolio rebalancing cadence, intra-day order execution windows, turnover mitigation rules, and trade throttling parameters for live ETF operations.

---

### Key Schema Elements

* **`schedule_regime`:**
  * `frequency`: The calendar cadence for calculating baseline portfolio target weights (`daily`, `weekly`, `monthly`, `quarterly`).
  * `rebalance_day_of_week` / `rebalance_day_of_month`: Specific target days for schedule evaluations (e.g., `FRIDAY`, `-1` for last trading day).
  * `holiday_convention`: Roll convention when a scheduled rebalance falls on an exchange holiday (`MODIFIED_FOLLOWING`, `PRECEDING`).
* **`execution_windows`:**
  * `market_timezone`: Operating market time zone (e.g., `America/New_York`).
  * `order_generation_time`: Exact time target weights are computed and validated against compliance rules.
  * `execution_open_time` & `execution_cutoff_time`: Bounded intra-day execution window to avoid opening/closing auction volatility, or configured for MOC (Market-On-Close) participation.
* **`turnover_controls` (Buffer Bands):**
  * `absolute_weight_buffer`: The minimum percentage-point drift required before generating an order (e.g., `0.005` = 50 bps). If $|w_{target} - w_{current}| < \text{buffer}$, the trade is suppressed.
  * `relative_weight_buffer`: Proportional drift threshold relative to target weight.
  * `min_order_notional_usd`: Hard dollar floor preventing micro-trades that produce inefficient transaction/custodial ticket fees.
  * `max_daily_turnover_pct`: Caps total portfolio turnover per rebalance cycle.

---

### Configuration Blueprint (`config/rebalance_schedule.json`)

```json
{
  "version": "1.0.0",
  "schedule_regime": {
    "frequency": "weekly",
    "rebalance_day_of_week": "FRIDAY",
    "rebalance_day_of_month": null,
    "holiday_convention": "PRECEDING"
  },
  "execution_windows": {
    "market_timezone": "America/New_York",
    "order_generation_time": "15:15:00",
    "execution_open_time": "15:30:00",
    "execution_cutoff_time": "15:55:00",
    "allow_moc_orders": true
  },
  "turnover_controls": {
    "absolute_weight_buffer": 0.005,
    "relative_weight_buffer": 0.10,
    "min_order_notional_usd": 1000.0,
    "max_daily_turnover_pct": 0.25,
    "enforce_lot_size": 1
  }
}

---

```python
import json
from datetime import datetime, time
from dataclasses import dataclass
from typing import Dict, List, Optional
import pandas as pd
import pytz


@dataclass
class OrderInstruction:
    ticker: str
    action: str  # 'BUY' or 'SELL'
    target_weight: float
    current_weight: float
    weight_delta: float
    target_shares: int
    estimated_notional_usd: float
    suppressed_by_buffer: bool
    reason: str


@dataclass
class RebalanceEvaluationResult:
    is_rebalance_due: bool
    is_within_execution_window: bool
    total_proposed_turnover_pct: float
    turnover_cap_exceeded: bool
    generated_orders: List[OrderInstruction]
    execution_summary: Dict[str, any]


class RebalanceExecutionEngine:
    """
    Evaluates calendar schedules, validates execution time windows,
    applies turnover buffer bands, and generates discrete orders.
    """

    def __init__(self, config_path: str = "config/rebalance_schedule.json"):
        with open(config_path, "r") as f:
            self.config = json.load(f)

        self.schedule = self.config["schedule_regime"]
        self.windows = self.config["execution_windows"]
        self.turnover = self.config["turnover_controls"]
        self.tz = pytz.timezone(self.windows["market_timezone"])

    def is_rebalance_day(self, current_dt: datetime) -> bool:
        """
        Determines whether the given date is a scheduled rebalancing day.
        """
        freq = self.schedule["frequency"].lower()

        if freq == "daily":
            return current_dt.weekday() < 5  # Monday-Friday

        if freq == "weekly":
            target_day_str = self.schedule.get("rebalance_day_of_week", "FRIDAY").upper()
            day_map = {
                "MONDAY": 0, "TUESDAY": 1, "WEDNESDAY": 2,
                "THURSDAY": 3, "FRIDAY": 4, "SATURDAY": 5, "SUNDAY": 6
            }
            target_weekday = day_map.get(target_day_str, 4)
            return current_dt.weekday() == target_weekday

        if freq == "monthly":
            # Target last day of month or specific date
            target_dom = self.schedule.get("rebalance_day_of_month", -1)
            if target_dom == -1:
                # Last calendar day check or next-day month roll
                return (current_dt + pd.Timedelta(days=1)).month != current_dt.month
            return current_dt.day == target_dom

        return False

    def is_within_order_window(self, current_dt: datetime) -> bool:
        """
        Checks if current local time falls within permitted trading windows.
        """
        local_time = current_dt.astimezone(self.tz).time()

        t_open = time.fromisoformat(self.windows["execution_open_time"])
        t_cutoff = time.fromisoformat(self.windows["execution_cutoff_time"])

        return t_open <= local_time <= t_cutoff

    def generate_orders(
        self,
        current_portfolio_df: pd.DataFrame,
        target_weights_df: pd.DataFrame,
        total_nav_usd: float,
        current_dt: Optional[datetime] = None
    ) -> RebalanceEvaluationResult:
        """
        Calculates trade differences and applies buffer bands and turnover caps.

        Expected DataFrame formats:
          - current_portfolio_df: ['ticker', 'current_weight', 'current_price']
          - target_weights_df:    ['ticker', 'target_weight']
        """
        if current_dt is None:
            current_dt = datetime.now(pytz.utc)

        rebalance_due = self.is_rebalance_day(current_dt)
        in_window = self.is_within_order_window(current_dt)

        # Merge target weights with current portfolio
        df = pd.merge(
            target_weights_df,
            current_portfolio_df,
            on="ticker",
            how="outer"
        ).fillna(0.0)

        abs_buffer = self.turnover["absolute_weight_buffer"]
        rel_buffer = self.turnover["relative_weight_buffer"]
        min_notional = self.turnover["min_order_notional_usd"]
        max_turnover_cap = self.turnover["max_daily_turnover_pct"]
        lot_size = self.turnover.get("enforce_lot_size", 1)

        orders: List[OrderInstruction] = []
        total_gross_trade_notional = 0.0

        for _, row in df.iterrows():
            ticker = row["ticker"]
            target_w = float(row["target_weight"])
            curr_w = float(row["current_weight"])
            price = float(row["current_price"]) if row["current_price"] > 0 else 1.0

            weight_delta = target_w - curr_w
            abs_delta = abs(weight_delta)
            est_trade_notional = abs_delta * total_nav_usd

            suppressed = False
            reason = "Active"

            # 1. Absolute buffer check
            if abs_delta < abs_buffer:
                suppressed = True
                reason = f"Abs delta ({abs_delta:.4f}) below buffer ({abs_buffer:.4f})"

            # 2. Relative buffer check (only if target > 0)
            elif target_w > 0 and (abs_delta / target_w) < rel_buffer:
                suppressed = True
                reason = f"Rel drift ({abs_delta / target_w:.2%}) below relative buffer ({rel_buffer:.2%})"

            # 3. Minimum dollar notional threshold check
            elif est_trade_notional < min_notional:
                suppressed = True
                reason = f"Notional (${est_trade_notional:,.2f}) below min dollar floor (${min_notional:,.2f})"

            # Calculate discrete share delta
            raw_shares = (weight_delta * total_nav_usd) / price
            target_shares = int(round(raw_shares / lot_size) * lot_size)

            if target_shares == 0 and not suppressed:
                suppressed = True
                reason = "Share lot rounding resulted in zero shares"

            action = "BUY" if weight_delta > 0 else "SELL"

            if not suppressed:
                total_gross_trade_notional += est_trade_notional

            orders.append(
                OrderInstruction(
                    ticker=ticker,
                    action=action,
                    target_weight=target_w,
                    current_weight=curr_w,
                    weight_delta=weight_delta,
                    target_shares=target_shares,
                    estimated_notional_usd=est_trade_notional,
                    suppressed_by_buffer=suppressed,
                    reason=reason
                )
            )

        # Turnover calculation: 0.5 * sum(|delta|) across portfolio
        portfolio_turnover_pct = (total_gross_trade_notional / (2.0 * total_nav_usd)) if total_nav_usd > 0 else 0.0
        turnover_breach = portfolio_turnover_pct > max_turnover_cap

        summary = {
            "evaluation_time_utc": current_dt.isoformat(),
            "portfolio_nav_usd": total_nav_usd,
            "total_orders_generated": len([o for o in orders if not o.suppressed_by_buffer]),
            "suppressed_orders_count": len([o for o in orders if o.suppressed_by_buffer]),
            "turnover_pct": portfolio_turnover_pct,
            "turnover_cap_pct": max_turnover_cap
        }

        return RebalanceEvaluationResult(
            is_rebalance_due=rebalance_due,
            is_within_execution_window=in_window,
            total_proposed_turnover_pct=portfolio_turnover_pct,
            turnover_cap_exceeded=turnover_breach,
            generated_orders=orders,
            execution_summary=summary
        )
